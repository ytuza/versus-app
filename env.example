# Archivo de ejemplo para variables de entorno
# Copia este archivo como .env y actualiza los valores

# Django
SECRET_KEY=tu-clave-secreta-aqui
DEBUG=False
ALLOWED_HOST=tu-app.onrender.com

# Base de datos (Render la configurará automáticamente)
DATABASE_URL=postgres://usuario:password@host:puerto/database

# CORS (actualizar con tu URL de GitHub Pages)
FRONTEND_URL=https://tu-usuario.github.io/versus-app

# SSL (para producción)
SECURE_SSL_REDIRECT=True
